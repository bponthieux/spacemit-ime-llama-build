# Copy this file to .env (in the same folder as spacemit-ime-build.sh) and fill in
# your own values. .env is git-ignored and must never be committed.

# SSH login for the target K3 board, as user@host-or-ip
JUP="youruser@your-board-hostname-or-ip"

# Path to the SSH private key used to log into the board
SSH_KEY="$HOME/.ssh/your_key"

# Path (on the target board) to the GGUF model file to benchmark
MODEL_PATH="/home/youruser/models/qwen2.5-0.5b-instruct-q4_k_m.gguf"

# Directory (on the target board) where binaries/libs get deployed
REMOTE_DIR="/home/youruser/spacemit-ime"
